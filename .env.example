# ============================================================
# TEMPLATE DE VARIABLES DE ENTORNO - MonitoreoPrensa
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env y pon tus keys reales
# 3. .env está en .gitignore → NO se sube a GitHub
# 4. .env.example SÍ se sube (sirve de documentación)
# ============================================================

# --- Groq (gratis, hasta 14,400 req/día) ---
# Consigue keys en: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=

# --- OpenRouter (gratis con límites) ---
# Consigue keys en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# --- Google Gemini (gratis, generoso) ---
# Consigue keys en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Anthropic Claude (pago, pero barato) ---
# Consigue keys en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Cerebras (gratis, muy rápido) ---
# Consigue keys en: https://cloud.cerebras.ai/platform/api-keys
CEREBRAS_API_KEY=

# --- Google Cloud (para Vertex AI, etc.) ---
# Consigue en: https://console.cloud.google.com/apis/credentials
GCP_API_KEY=